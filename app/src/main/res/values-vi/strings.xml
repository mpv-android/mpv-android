    <string name="pref_video_interpolation_title">Nội suy</string>
    <string name="pref_video_interpolation_message">Giảm hiện tượng giật hình do FPS của video không khớp với tần số làm mới của màn hình.</string>

    <string name="pref_video_tscale_title">Bộ lọc nội suy thời gian</string>
    <string name="pref_video_tscale_summary">Chọn bộ lọc dùng để nội suy theo trục thời gian (khung hình).</string>
    <string name="pref_video_tscale_message">Các cài đặt này chỉ có hiệu lực khi đã bật nội suy ở trên.</string>

    <string name="pref_video_fastdecode_title">Giải mã video chất lượng thấp</string>
    <string name="pref_video_fastdecode_summary">Đánh đổi chất lượng để lấy hiệu năng, giúp phát mượt mà.\n<b>GIẢM CHẤT LƯỢNG RẤT NHIỀU</b></string>

    <string name="pref_ignore_audio_focus_title">Bỏ qua tiêu điểm âm thanh</string>
