    <string name="pref_default_audio_language_title">Ngôn ngữ âm thanh mặc định</string>
    <string name="pref_default_audio_language_message">Ngôn ngữ âm thanh được chọn mặc định khi phát video có nhiều luồng âm thanh.\nCó thể dùng mã ngôn ngữ gồm hai hoặc ba chữ cái. Có thể nhập nhiều giá trị, phân tách bằng dấu phẩy.</string>

    <string name="pref_default_subtitle_language_title">Ngôn ngữ phụ đề mặc định</string>
    <string name="pref_default_subtitle_language_message">Ngôn ngữ phụ đề được chọn mặc định khi phát video có nhiều phụ đề.\nCó thể dùng mã ngôn ngữ gồm hai hoặc ba chữ cái. Có thể nhập nhiều giá trị, phân tách bằng dấu phẩy.</string>

    <string name="pref_hardware_decoding_title">Giải mã bằng phần cứng</string>
    <string name="pref_hardware_decoding_summary">Thử giải mã bằng phần cứng trước khi chuyển sang phần mềm. Cách này thường hiệu quả hơn.</string>

    <string name="pref_background_play_title">Phát trong nền</string>
    <string name="pref_background_play_summary">Chọn khi nào tự động tiếp tục phát trong nền.</string>

    <string name="pref_save_position_title">Lưu vị trí khi thoát</string>
    <string name="pref_save_position_summary">Ghi nhớ vị trí phát hiện tại khi thoát. Khi phát lại cùng tệp đó, mpv sẽ tua đến vị trí trước đó.</string>

    <string name="pref_remember_brightness_title">Ghi nhớ độ sáng màn hình</string>
    <string name="pref_remember_brightness_summary">Khôi phục độ sáng màn hình đã đặt trước đó khi khởi động trình phát.</string>

    <string name="pref_new_intent_replace_title">Phát tệp mới ngay lập tức</string>
    <string name="pref_new_intent_replace_summary">Khi mở tệp mới trong lúc mpv đang chạy trong nền, thay thế danh sách phát hiện tại thay vì thêm vào cuối.</string>

    <string name="pref_auto_rotation_title">Hướng màn hình</string>
    <string name="pref_auto_rotation_summary">Chọn hướng màn hình mà mpv dùng để phát video ngang hoặc video dọc.</string>

    <string name="pref_display_media_title_title">Hiển thị tiêu đề nội dung (video)</string>
    <string name="pref_display_media_title_summary">Hiển thị tiêu đề hoặc tên tệp của video phía trên các nút điều khiển. Tệp âm thanh luôn hiển thị siêu dữ liệu của chúng.</string>

    <string name="pref_bottom_controls_title">Hiển thị nút điều khiển ở dưới cùng màn hình</string>

    <string name="pref_no_ui_pause_title">Tiếp tục phát khi có cửa sổ bật lên</string>
    <string name="pref_no_ui_pause_summary">Tiếp tục phát trong khi các cửa sổ bật lên đang mở. (ví dụ: khi mở hộp thoại danh sách phát)</string>

    <string name="pref_playlist_exit_warning_title">Xác nhận thoát khi có danh sách phát</string>
    <string name="pref_playlist_exit_warning_summary">Hiển thị hộp thoại xác nhận trước khi thoát nếu đã tải một danh sách phát.</string>

