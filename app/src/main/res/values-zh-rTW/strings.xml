    <string name="pref_hardware_decoding_title">硬體解碼</string>
    <string name="pref_hardware_decoding_summary">優先嘗試硬體解碼，失敗時再改用軟體解碼。這通常更有效率。</string>

    <string name="pref_background_play_title">背景播放</string>
    <string name="pref_background_play_summary">決定何時自動在背景繼續播放。</string>

    <string name="pref_save_position_title">結束時儲存播放位置</string>
    <string name="pref_save_position_summary">結束時記住目前的播放位置。下次播放同一個檔案時，mpv 會跳到先前的位置。</string>

    <string name="pref_remember_brightness_title">記住螢幕亮度</string>
    <string name="pref_remember_brightness_summary">啟動播放器時還原先前設定的螢幕亮度。</string>

    <string name="pref_new_intent_replace_title">立即播放新檔案</string>
    <string name="pref_new_intent_replace_summary">mpv 在背景執行時開啟新檔案，會取代目前的播放清單，而不是加到清單末端。</string>

