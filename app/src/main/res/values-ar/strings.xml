    <string name="pref_default_audio_language_title">لغة الصوت الافتراضية</string>
    <string name="pref_default_audio_language_message">لغة (أو لغات) الصوت التي سيتم تحديدها افتراضيًا عند تشغيل فيديو يحتوي على تدفقات صوتية متعددة.\nتعمل رموز اللغات المكونة من حرفين أو ثلاثة أحرف. يمكن فصل القيم المتعددة بفاصلة.</string>
    <string name="pref_default_audio_language_summary" translatable="false">%s</string>

    <string name="pref_default_subtitle_language_title">لغة الترجمة الافتراضية</string>
    <string name="pref_default_subtitle_language_message">لغة (أو لغات) الترجمة التي سيتم تحديدها افتراضيًا عند تشغيل فيديو يحتوي على ترجمات متعددة.\nتعمل رموز اللغات المكونة من حرفين أو ثلاثة أحرف. يمكن فصل القيم المتعددة بفاصلة.</string>
    <string name="pref_default_subtitle_language_summary" translatable="false">%s</string>

    <string name="pref_hardware_decoding_title">فك التشفير عبر العتاد</string>
    <string name="pref_hardware_decoding_summary">محاولة فك التشفير عبر العتاد قبل الرجوع إلى البرامج. يُعد هذا الخيار أكثر كفاءة بشكل عام.</string>

    <string name="pref_background_play_title">التشغيل في الخلفية</string>
    <string name="pref_background_play_summary">حدد متى يجب استئناف التشغيل تلقائيًا في الخلفية.</string>
    <string name="pref_background_play_default" translatable="false">never</string>

    <string name="pref_save_position_title">حفظ الموضع عند الخروج</string>
    <string name="pref_save_position_summary">تذكر موضع التشغيل الحالي عند الخروج. عند تشغيل نفس الملف مرة أخرى، سيقوم mpv بالانتقال إلى الموضع السابق.</string>

    <string name="pref_remember_brightness_title">تذكر سطوع الشاشة</string>
    <string name="pref_remember_brightness_summary">استعادة سطوع الشاشة المحدد مسبقًا عند بدء تشغيل المشغل.</string>

    <string name="pref_new_intent_replace_title">تشغيل الملفات الجديدة فورًا</string>
    <string name="pref_new_intent_replace_summary">عند فتح ملفات جديدة أثناء وجود mpv في الخلفية، استبدل قائمة التشغيل الحالية بدلاً من الإضافة إلى نهايتها.</string>

    <string name="pref_auto_rotation_title">اتجاه الشاشة</string>
    <string name="pref_auto_rotation_summary">حدد الاتجاه الذي سيشغل به mpv مقاطع الفيديو الأفقية أو الرأسية.</string>
    <string name="pref_auto_rotation_default" translatable="false">auto</string>

    <string name="pref_display_media_title_title">عرض عنوان الوسائط (مقاطع الفيديو)</string>
    <string name="pref_display_media_title_summary">عرض عنوان أو اسم ملف مقاطع الفيديو فوق عناصر التحكم. ستعرض ملفات الصوت دائمًا بياناتها الوصفية.</string>

