    <string name="pref_no_ui_pause_summary">متابعة التشغيل أثناء فتح النوافذ المنبثقة. (مثلًا أثناء مربع حوار قائمة التشغيل)</string>
    <string name="pref_no_ui_pause_default" translatable="false">audio-only</string>

